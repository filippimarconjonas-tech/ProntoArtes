{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prontoartes",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prontoartes-crm",
      "database_id": "b8e4b1da-e36a-4ca3-a218-3c6ade92c5cc",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // Variável opcional (Settings > Variables and Secrets no painel da Cloudflare):
  //   LEAD_WEBHOOK_URL = URL que também recebe cada lead em JSON (planilha, automação, etc.).
}
